---
import { supabase } from "../../lib/supabase";
import { getShareTier } from "../../lib/shareUtils";

const { id } = Astro.params;

const { data: recipe } = await supabase
  .rpc("get_public_recipe", { p_recipe_id: Number(id) })
  .maybeSingle();

if (!recipe) {
  return new Response(null, { status: 404, statusText: "Not found" });
}

const tier = getShareTier(recipe.source, recipe.is_original);

// Fetch ingredients from the separate table
const { data: ingredientRows } = await supabase
  .from("recipe_ingredients")
  .select("amount, unit, raw_text, canonical_name, ingredient_role")
  .eq("recipe_id", Number(id))
  .order("id", { ascending: true });

// Instructions are only returned by the RPC for original (Tier 1) recipes;
// non-original recipes get null from the server.
const instructions: string[] = recipe.instructions
  ? typeof recipe.instructions === "string"
    ? JSON.parse(recipe.instructions)
    : recipe.instructions
  : [];

const { data: ownerProfile } = await supabase
  .from('user_profiles')
  .select('display_name, handle')
  .eq('household_id', recipe.household_id)
  .single();

const ownerName = ownerProfile?.display_name ?? 'Sheila';
const ownerHandle = ownerProfile?.handle ?? 'sheila';
const sourceDomain = recipe.link ? new URL(recipe.link).hostname.replace(/^www\./, '') : null;

// Fetch recipe notes (replaces my_adaptations)
const { data: noteRows } = await supabase
  .from("recipe_adaptations")
  .select("note, created_at")
  .eq("recipe_id", Number(id))
  .order("created_at", { ascending: false, nullsFirst: false });

const notes = (noteRows ?? []).map((row) => ({
  note: row.note,
  dateLabel: row.created_at
    ? new Date(row.created_at).toLocaleDateString("en-US", { month: "long", year: "numeric" })
    : "earlier",
}));

const myNotes = recipe.my_notes?.trim() || null;
const hasNotes = notes.length > 0;
const hasMainColumn = myNotes || hasNotes;
const latestNote = hasNotes ? notes[0] : null;
const olderNotes = notes.slice(1);
const VISIBLE_OLDER = 2;
const visibleOlder = olderNotes.slice(0, VISIBLE_OLDER);
const hiddenOlder = olderNotes.slice(VISIBLE_OLDER);

const SMALL_WORDS = new Set([
  'a','an','the','and','but','or','for','nor',
  'on','at','to','by','in','of','with','from',
]);

function toTitleCase(text: string): string {
  const words = text.split(/\s+/);
  return words.map((word, i) => {
    const lower = word.toLowerCase();
    if (i === 0 || i === words.length - 1 || !SMALL_WORDS.has(lower)) {
      return word.charAt(0).toUpperCase() + word.slice(1).toLowerCase();
    }
    return lower;
  }).join(' ');
}

const pageTitle = `${recipe.name} · ${ownerName}'s kitchen`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>{pageTitle}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={`${recipe.name} — shared from ${ownerName}'s kitchen on Kalamansi`} />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Crimson+Text:ital,wght@0,400;0,600;0,700;1,400;1,600&family=Inter:wght@400;500;600;700&display=swap"
    />
    <style>
      :root {
        /* Surfaces */
        --bg: #F0EEE9;
        --surface: #FFFFFF;
        --surface-muted: #F4F2EE;
        --border: #E8E4DE;
        /* Text */
        --fg: #363230;
        --fg-muted: #8C8480;
        --fg-faint: #C4BFB9;
        /* Brand */
        --primary: #6B7A2F;
        --primary-press: #5A6727;
        /* Warm tones */
        --warm-card: #E8E3D8;
        --warm-fg: #3A3028;
        --warm-fg-muted: #6A5840;
        /* Type */
        --font-display: "Crimson Text", "Iowan Old Style", Georgia, serif;
        --font-body: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        /* Radii */
        --r-card: 14px;
        /* Layout */
        --bleed: 20px;
        --max-width: 1100px;
      }

      *, *::before, *::after { box-sizing: border-box; }
      html, body { margin: 0; }
      body {
        background: var(--bg);
        color: var(--fg);
        font-family: var(--font-body);
        -webkit-font-smoothing: antialiased;
        line-height: 1.55;
      }
      a { color: inherit; }
      a.plain { text-decoration: none; }

      /* ---- Nav ---- */
      .nav {
        max-width: var(--max-width);
        margin: 0 auto;
        padding: 20px var(--bleed) 0;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
      }
      .back {
        font-size: 13px;
        color: var(--fg-muted);
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 4px;
      }
      .back:hover { color: var(--fg); }
      .wm {
        display: flex;
        align-items: center;
        gap: 6px;
        text-decoration: none;
      }
      .wm span {
        font-size: 13px;
        color: var(--fg-muted);
        letter-spacing: 0.5px;
      }

      /* ---- Hero photo ---- */
      .hero {
        max-width: var(--max-width);
        margin: 24px auto 0;
        padding: 0 var(--bleed);
      }
      .hero-photo {
        width: 100%;
        aspect-ratio: 4 / 3;
        background: #E8E3D8;
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
        overflow: hidden;
      }
      .hero-photo .glyph {
        font-size: 140px;
        opacity: 0.22;
        filter: saturate(0.7);
      }
      .hero-photo .stamp {
        position: absolute;
        bottom: 18px;
        left: 22px;
        font-family: var(--font-body);
        font-size: 11px;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        color: rgba(54, 50, 48, 0.55);
      }

      /* ---- Title block ---- */
      .title-block {
        max-width: var(--max-width);
        margin: 28px auto 0;
        padding: 0 var(--bleed);
      }
      .source-line {
        font-size: 13px;
        color: var(--fg-muted);
        margin-top: 12px;
      }
      .source-line strong {
        color: var(--fg);
        font-weight: 500;
      }
      .source-line a {
        color: var(--primary);
        text-decoration: none;
      }
      .source-line a:hover { text-decoration: underline; }
      .title {
        font-family: var(--font-display);
        font-weight: 600;
        font-size: 32px;
        color: var(--fg);
        letter-spacing: -0.01em;
        line-height: 1.05;
        margin: 0 0 12px;
      }
      .meta {
        font-size: 13px;
        color: var(--fg-muted);
        display: flex;
        flex-wrap: wrap;
        gap: 14px;
      }
      .meta .dot { color: var(--fg-faint); }

      /* ---- Body layout ---- */
      .body-wrap {
        max-width: var(--max-width);
        margin: 32px auto 0;
        padding: 0 var(--bleed) 64px;
        display: grid;
        grid-template-columns: 1fr;
        gap: 32px;
      }

      /* ---- Adaptation block ---- */
      .eyebrow {
        font-family: var(--font-body);
        font-size: 11px;
        font-weight: 600;
        color: var(--fg-muted);
        letter-spacing: 1.5px;
        text-transform: uppercase;
        margin: 0 0 16px;
      }
      .adapt-body p {
        font-family: var(--font-display);
        font-style: italic;
        font-size: 21px;
        color: var(--fg);
        line-height: 1.55;
        margin: 0 0 16px;
        text-wrap: pretty;
      }
      .adapt-body p strong {
        font-style: normal;
        font-weight: 600;
      }

      /* ---- Standing note (my_notes) ---- */
      .standing-note {
        background: var(--warm-card);
        border-radius: var(--r-card);
        padding: 24px;
        margin-bottom: 32px;
      }
      .standing-note .eyebrow { margin-bottom: 12px; }
      .standing-note-body {
        font-family: var(--font-display);
        font-style: italic;
        font-size: 21px;
        color: var(--fg);
        line-height: 1.55;
        margin: 0;
        text-wrap: pretty;
        white-space: pre-line;
      }
      @media (min-width: 800px) {
        .standing-note-body { font-size: 24px; }
      }

      /* ---- Older notes list ---- */
      .notes-list {
        margin-top: 8px;
        border-top: 1px solid var(--border);
        padding-top: 16px;
        display: flex;
        flex-direction: column;
        gap: 12px;
      }
      .note-row {
        display: flex;
        gap: 14px;
        align-items: baseline;
      }
      .note-date {
        font-family: var(--font-body);
        font-size: 13px;
        color: var(--fg-muted);
        flex-shrink: 0;
        min-width: 100px;
      }
      .note-text {
        font-family: var(--font-display);
        font-style: italic;
        font-size: 16px;
        color: var(--fg);
        line-height: 1.5;
        margin: 0;
      }
      .notes-expand {
        margin-top: 4px;
      }
      .notes-expand summary {
        font-family: var(--font-body);
        font-size: 13px;
        color: var(--fg-muted);
        cursor: pointer;
        list-style: none;
      }
      .notes-expand summary::-webkit-details-marker { display: none; }
      .notes-expand summary::marker { display: none; content: ""; }
      .notes-expand summary:hover { color: var(--fg); }
      .notes-expand .notes-hidden {
        display: flex;
        flex-direction: column;
        gap: 12px;
        margin-top: 12px;
      }

      /* ---- Sidebar ---- */
      .side {
        display: flex;
        flex-direction: column;
        gap: 24px;
      }

      /* ---- Ingredients card ---- */
      .ingredients {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: var(--r-card);
        padding: 24px;
      }
      .ingredients h3 { margin: 0 0 14px; }
      .ingredients ul {
        list-style: none;
        padding: 0;
        margin: 0;
      }
      .ingredients li {
        padding: 9px 0;
        border-top: 1px solid var(--border);
        font-size: 15px;
        color: var(--fg);
      }
      .ingredients li:first-child {
        border-top: none;
        padding-top: 0;
      }

      /* ---- Instructions (Tier 1 only) ---- */
      .instructions {
        padding: 0;
      }
      .instructions ol {
        padding-left: 24px;
        margin: 0;
      }
      .instructions li {
        font-size: 15px;
        color: var(--fg);
        padding: 6px 0;
        line-height: 1.55;
      }

      /* ---- CTA card ---- */
      .save-cta {
        background: var(--warm-card);
        border-radius: var(--r-card);
        padding: 22px;
      }
      .save-cta h4 {
        font-family: var(--font-display);
        font-weight: 600;
        font-size: 20px;
        color: var(--warm-fg);
        margin: 0 0 8px;
        line-height: 1.2;
      }
      .save-cta p {
        font-size: 13px;
        color: var(--warm-fg-muted);
        margin: 0 0 16px;
        line-height: 1.5;
      }
      .save-cta .btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: var(--warm-fg);
        color: var(--bg);
        font-family: var(--font-body);
        font-size: 14px;
        font-weight: 600;
        padding: 10px 18px;
        border-radius: 999px;
        cursor: pointer;
        border: none;
        text-decoration: none;
      }
      .save-cta .btn:hover {
        background: var(--fg);
      }

      /* ---- Source footer ---- */
      .source-footer {
        max-width: var(--max-width);
        margin: 0 auto;
        padding: 24px var(--bleed) 64px;
        border-top: 1px solid var(--border);
        display: flex;
        flex-direction: column;
        gap: 4px;
      }
      .source-footer .eyebrow { margin: 0; }
      .source-footer a {
        font-family: var(--font-display);
        font-style: italic;
        font-size: 20px;
        color: var(--fg);
        text-decoration: none;
        margin-top: 4px;
        display: inline-flex;
        align-items: baseline;
        gap: 8px;
      }
      .source-footer a:hover { color: #5A6727; }
      .source-footer small {
        font-family: var(--font-body);
        font-style: normal;
        font-size: 13px;
        color: var(--fg-muted);
        margin-top: 4px;
      }

      /* ---- App Store CTA section ---- */
      .app-cta {
        background: var(--warm-card);
        padding: 64px var(--bleed);
      }
      .app-cta-inner {
        max-width: var(--max-width);
        margin: 0 auto;
        text-align: center;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 20px;
      }
      .app-cta h2 {
        font-family: var(--font-display);
        font-weight: 600;
        font-size: 32px;
        color: var(--warm-fg);
        margin: 0;
        line-height: 1.15;
      }
      .app-cta .btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: var(--warm-fg);
        color: var(--bg);
        font-family: var(--font-body);
        font-size: 14px;
        font-weight: 600;
        padding: 12px 24px;
        border-radius: 999px;
        text-decoration: none;
        border: none;
        cursor: pointer;
      }
      .app-cta .btn:hover {
        background: var(--fg);
      }

      /* ---- Desktop ---- */
      @media (min-width: 800px) {
        :root { --bleed: 40px; }
        .nav { padding-top: 28px; }
        .hero { margin-top: 32px; }
        .hero-photo {
          aspect-ratio: 16 / 9;
          max-height: 460px;
        }
        .hero-photo .glyph { font-size: 200px; }
        .title { font-size: 36px; }
        .title-block { margin-top: 40px; }
        .body-wrap {
          grid-template-columns: minmax(0, 1.4fr) minmax(280px, 340px);
          gap: 64px;
          margin-top: 48px;
          padding-bottom: 96px;
        }
        .body-wrap--single {
          grid-template-columns: 1fr;
        }
        .adapt-body p { font-size: 24px; }
        .note-text { font-size: 17px; }
        .app-cta h2 { font-size: 40px; }
      }
    </style>
  </head>
  <body>

    <!-- Nav -->
    <header class="nav">
      <a class="back" href={`/kitchen/${ownerHandle}`}>&lsaquo; {ownerName}&rsquo;s kitchen</a>
      <a class="plain wm" href="/">
        <span>kalamansi</span>
      </a>
    </header>

    <!-- Hero -->
    {recipe.emoji && (
      <section class="hero">
        <div class="hero-photo">
          <span class="glyph">{recipe.emoji}</span>
          {(recipe.category || recipe.cook_time) && (
            <span class="stamp">
              {[recipe.category, recipe.cook_time].filter(Boolean).join(" \u00B7 ")}
            </span>
          )}
        </div>
      </section>
    )}

    <!-- Title block -->
    <section class="title-block">
      <h1 class="title">{toTitleCase(recipe.name)}</h1>
      {tier === 2 && (
        <div class="source-line">
          From{" "}
          {recipe.attribution?.trim() && recipe.link ? (
            <a href={recipe.link} target="_blank" rel="noopener">
              {recipe.attribution} &#8599;
            </a>
          ) : recipe.link ? (
            <a href={recipe.link} target="_blank" rel="noopener">
              {sourceDomain} &#8599;
            </a>
          ) : (
            "the web"
          )}
        </div>
      )}
      {tier === 3 && recipe.cookbook_name && (
        <div class="source-line">
          From <strong>{recipe.cookbook_name}</strong>
        </div>
      )}
      <div class="meta">
        {recipe.cook_count != null && recipe.cook_count > 0 && (
          <span>
            {ownerName} cooked this{" "}
            <strong style="color:var(--fg);font-weight:500;">
              {recipe.cook_count} {recipe.cook_count === 1 ? "time" : "times"}
            </strong>
          </span>
        )}
      </div>
    </section>

    <!-- Body -->
    <div class={`body-wrap${hasMainColumn ? '' : ' body-wrap--single'}`}>

      {/* Main column — standing note + cook notes */}
      {hasMainColumn && (
        <div>
          {myNotes && (
            <section class="standing-note">
              <p class="eyebrow">{ownerName}&rsquo;s notes</p>
              <p class="standing-note-body">{myNotes}</p>
            </section>
          )}
          {hasNotes && latestNote && (
            <article class="adapt-block">
              <p class="eyebrow">Cook {notes.length === 1 ? 'note' : 'notes'}</p>
              <div class="adapt-body">
                <p>{latestNote.note}</p>
              </div>
              <p class="note-date" style="margin: 8px 0 0;">{latestNote.dateLabel}</p>

              {visibleOlder.length > 0 && (
                <div class="notes-list">
                  {visibleOlder.map((n) => (
                    <div class="note-row">
                      <span class="note-date">{n.dateLabel}</span>
                      <p class="note-text">{n.note}</p>
                    </div>
                  ))}

                  {hiddenOlder.length > 0 && (
                    <details class="notes-expand">
                      <summary>show {hiddenOlder.length} more {hiddenOlder.length === 1 ? 'note' : 'notes'}</summary>
                      <div class="notes-hidden">
                        {hiddenOlder.map((n) => (
                          <div class="note-row">
                            <span class="note-date">{n.dateLabel}</span>
                            <p class="note-text">{n.note}</p>
                          </div>
                        ))}
                      </div>
                    </details>
                  )}
                </div>
              )}
            </article>
          )}

          {/* Instructions (server only returns these for original recipes) */}
          {instructions.length > 0 && (
            <section class="instructions">
              <p class="eyebrow">Instructions</p>
              <ol>
                {instructions.map((step: string) => (
                  <li>{step}</li>
                ))}
              </ol>
            </section>
          )}
        </div>
      )}

      <!-- Sidebar -->
      <aside class="side">
        {/* Ingredients */}
        {ingredientRows && ingredientRows.length > 0 && (
          <section class="ingredients">
            <p class="eyebrow">What you&rsquo;ll need</p>
            <ul>
              {ingredientRows.map((ing) => (
                <li>{ing.raw_text ?? ing.canonical_name}</li>
              ))}
            </ul>
          </section>
        )}

        {/* Save CTA card */}
        <section class="save-cta">
          <h4>Save this in Kalamansi.</h4>
          <p>
            Keep {ownerName}&rsquo;s note in your own kitchen notebook. Log when
            you cook it, jot your own tweaks, share with your household.
          </p>
          <button class="btn" type="button" id="save-cta">
            Save to try <span style="font-size:13px;">&rarr;</span>
          </button>
        </section>
      </aside>
    </div>

    <!-- Source footer (Tier 2 — link back to original) -->
    {tier === 2 && recipe.source_url && (
      <section class="source-footer">
        <p class="eyebrow">Where the recipe came from</p>
        <a href={recipe.source_url} target="_blank" rel="noopener">
          {recipe.attribution ?? recipe.source_url}{" "}
          <span style="font-style:normal;color:var(--fg-muted);">&uarr;</span>
        </a>
        <small>
          Full instructions and timing live on the original site. This page only
          shows {ownerName}&rsquo;s note.
        </small>
      </section>
    )}

    {/* Source footer (Tier 3 — cookbook name) */}
    {tier === 3 && recipe.cookbook_name && (
      <section class="source-footer">
        <p class="eyebrow">Where the recipe came from</p>
        <span style="font-family:var(--font-display);font-style:italic;font-size:20px;">
          {recipe.cookbook_name}
        </span>
      </section>
    )}

    {/* Attribution footer (Tier 1) */}
    {tier === 1 && recipe.attribution && (
      <section class="source-footer">
        <p class="eyebrow">Attribution</p>
        <span style="font-family:var(--font-display);font-style:italic;font-size:20px;">
          {recipe.attribution}
        </span>
      </section>
    )}

    <!-- App Store CTA -->
    <section class="app-cta">
      <div class="app-cta-inner">
        <h2>Build your own kitchen.<br />Get Kalamansi</h2>
        <a class="btn" href="/">
          App Store <span style="font-size:13px;">&rarr;</span>
        </a>
      </div>
    </section>

    <script define:vars={{ id }}>
      document.getElementById('save-cta').addEventListener('click', function () {
        this.disabled = true;
        window.location.href = 'kalamansi://recipe-save/' + id;
        setTimeout(function () {
          if (!document.hidden) {
            window.location.href = '/recipe-save/' + id;
          }
        }, 1500);
      });
    </script>

  </body>
</html>
