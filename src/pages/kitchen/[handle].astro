---
import { supabase } from "../../lib/supabase";

const { handle } = Astro.params;

const { data: profile } = await supabase
  .from('user_profiles')
  .select('user_id, household_id, display_name, handle, avatar_url')
  .eq('handle', handle)
  .single();

if (!profile) {
  return new Response(null, { status: 404, statusText: "Not found" });
}

const { data: recipes } = await supabase
  .from('recipes')
  .select('id, name, source, link, attribution, cookbook_name, my_adaptations, is_original, recipe_status, auto_tags')
  .eq('household_id', profile.household_id)
  .eq('recipe_status', 'keeper')
  .eq('is_hidden', false)
  .order('name', { ascending: true });

const recipeCount = recipes?.length ?? 0;
const initials = profile.display_name
  .split(' ')
  .map((w: string) => w[0])
  .join('')
  .toUpperCase()
  .slice(0, 2);
const pageTitle = `${profile.display_name}'s kitchen · Kalamansi`;

function truncate(text: string, max: number): string {
  if (text.length <= max) return text;
  return text.slice(0, max).trimEnd() + '\u2026';
}

const FORMAT_EMOJI_MAP: Record<string, string> = {
  soup: "🍲", bowl: "🥣", salad: "🥗", pasta: "🍝", baked_good: "🧁",
  breakfast: "🍳", sandwich: "🥪", stew: "🫕", curry: "🍛", stir_fry: "🥢",
  snack: "🍿", wrap: "🌯", rice: "🍚", noodles: "🍜", baked: "🥘",
  roast: "🥩", grilled: "🔥", sushi: "🍣", tacos: "🌮", pizza: "🍕",
  dessert: "🍰", other: "🍴"
};

const getRecipeEmoji = (recipe: any) => {
  const format = recipe.auto_tags?.format;
  return format ? (FORMAT_EMOJI_MAP[format] ?? "🍽️") : "🍽️";
};

const WARM_TONES = ["#E8E3D8", "#ECE3C6", "#DDDDC2", "#E0CFB8", "#E5C9BA", "#F0E8D8"];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>{pageTitle}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={`${profile.display_name}'s kitchen on Kalamansi — ${recipeCount} keeper recipes`} />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Crimson+Text:ital,wght@0,400;0,600;0,700;1,400;1,600&family=Inter:wght@400;500;600;700&display=swap"
    />
    <style>
      :root {
        /* Surfaces */
        --bg: #F0EEE9;
        --surface: #FFFFFF;
        --border: #E8E4DE;
        /* Text */
        --fg: #363230;
        --fg-muted: #8C8480;
        --fg-faint: #C4BFB9;
        /* Brand */
        --teal: #1D9E75;
        --teal-light: #E6F4EF;
        /* Warm tones */
        --warm-card: #E8E3D8;
        --warm-fg: #3A3028;
        --warm-fg-muted: #6A5840;
        /* Type */
        --font-display: "Crimson Text", "Iowan Old Style", Georgia, serif;
        --font-body: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        /* Layout */
        --bleed: 20px;
        --max-width: 1100px;
      }

      *, *::before, *::after { box-sizing: border-box; }
      html, body { margin: 0; }
      body {
        background: var(--bg);
        color: var(--fg);
        font-family: var(--font-body);
        -webkit-font-smoothing: antialiased;
        line-height: 1.5;
      }
      a { color: inherit; text-decoration: none; }

      /* ─── top wordmark ─────────────────────────── */
      .top {
        max-width: var(--max-width);
        margin: 0 auto;
        padding: 20px var(--bleed) 0;
        display: flex;
        justify-content: flex-end;
        align-items: center;
        gap: 6px;
      }
      .top span {
        font-size: 13px;
        color: var(--fg-muted);
        letter-spacing: 0.5px;
      }

      /* ─── header ───────────────────────────────── */
      .hdr {
        max-width: var(--max-width);
        margin: 0 auto;
        padding: 32px var(--bleed) 24px;
      }
      .hdr-row {
        display: flex;
        flex-direction: row;
        align-items: flex-start;
        gap: 24px;
      }
      .avatar {
        width: 80px;
        height: 80px;
        border-radius: 50%;
        background: var(--surface);
        border: 1px solid var(--border);
        overflow: hidden;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
      }
      .avatar img {
        width: 100%;
        height: 100%;
        object-fit: cover;
      }
      .avatar-initials {
        font-family: var(--font-display);
        font-weight: 600;
        font-size: 28px;
        color: var(--fg-muted);
        line-height: 1;
      }
      .hdr-text {
        flex: 1;
        min-width: 0;
      }
      .name {
        font-family: var(--font-display);
        font-weight: 600;
        font-size: 36px;
        color: var(--fg);
        line-height: 1.05;
        letter-spacing: -0.01em;
        margin: 0;
      }
      .bio {
        font-size: 15px;
        color: var(--fg-muted);
        margin: 6px 0 0;
        max-width: 38em;
        line-height: 1.5;
      }
      .stats {
        display: flex;
        gap: 28px;
        margin-top: 14px;
      }
      .stat-num {
        font-family: var(--font-display);
        font-weight: 600;
        font-size: 24px;
        color: var(--fg);
        line-height: 1;
      }
      .stat-lbl {
        font-size: 12px;
        color: var(--fg-muted);
        margin-top: 4px;
        letter-spacing: 0.15px;
      }

      /* ─── grid ─────────────────────────────────── */
      .grid {
        max-width: var(--max-width);
        margin: 0 auto;
        padding: 24px var(--bleed) 64px;
        display: grid;
        grid-template-columns: 1fr;
        gap: 24px;
      }
      .card {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 14px;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        cursor: pointer;
        transition: transform 180ms ease, border-color 180ms ease;
      }
      .card:hover {
        border-color: #D7D0C5;
        transform: translateY(-1px);
      }
      .card-photo {
        aspect-ratio: 3 / 2;
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
        overflow: hidden;
      }
      .card-emoji {
        font-size: 72px;
        opacity: 0.4;
        line-height: 1;
      }
      .card-format-label {
        position: absolute;
        bottom: 8px;
        left: 10px;
        font-size: 10px;
        font-weight: 600;
        letter-spacing: 0.5px;
        text-transform: uppercase;
        color: rgba(54, 50, 48, 0.45);
        line-height: 1;
      }
      .card-body {
        padding: 16px 18px 18px;
        display: flex;
        flex-direction: column;
        gap: 6px;
      }
      .src {
        font-size: 12px;
        color: var(--fg-muted);
        letter-spacing: 0.1px;
      }
      .src strong {
        color: var(--fg);
        font-weight: 500;
        white-space: nowrap;
      }
      .badge {
        display: inline-block;
        padding: 2px 8px;
        border-radius: 999px;
        background: var(--teal-light);
        color: var(--teal);
        font-size: 11px;
        font-weight: 600;
        letter-spacing: 0.6px;
        text-transform: uppercase;
        align-self: flex-start;
      }
      .dish {
        font-family: var(--font-display);
        font-weight: 600;
        font-size: 22px;
        color: var(--fg);
        line-height: 1.18;
        margin: 0;
      }
      .note {
        font-family: var(--font-display);
        font-style: italic;
        font-size: 15px;
        color: #5C5650;
        line-height: 1.5;
        margin: 4px 0 0;
      }

      /* ─── CTA ──────────────────────────────────── */
      .cta {
        background: var(--warm-card);
        padding: 40px var(--bleed);
        margin-top: 32px;
      }
      .cta-inner {
        max-width: var(--max-width);
        margin: 0 auto;
        text-align: center;
      }
      .cta-head {
        font-family: var(--font-display);
        font-weight: 600;
        font-size: 26px;
        color: var(--warm-fg);
        margin: 0 0 8px;
        line-height: 1.15;
      }
      .cta-sub {
        font-size: 14px;
        color: var(--warm-fg-muted);
        margin: 0 0 18px;
        max-width: 28em;
        margin-left: auto;
        margin-right: auto;
        line-height: 1.5;
      }
      .cta-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: var(--warm-fg);
        color: var(--bg);
        font-family: var(--font-body);
        font-size: 15px;
        font-weight: 600;
        padding: 12px 22px;
        border-radius: 999px;
        cursor: pointer;
        border: none;
        letter-spacing: 0.1px;
      }
      .cta-btn:hover { background: #2A211B; }

      /* ─── footer ──────────────────────────────── */
      .ftr {
        padding: 28px var(--bleed) 48px;
        max-width: var(--max-width);
        margin: 0 auto;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        font-size: 12px;
        color: var(--fg-faint);
      }
      .ftr a { color: var(--fg-muted); }

      /* ─── DESKTOP ─────────────────────────────── */
      @media (min-width: 760px) {
        :root { --bleed: 32px; }
        .top { padding-top: 28px; }
        .hdr { padding: 56px var(--bleed) 36px; }
        .hdr-row { gap: 40px; }
        .avatar { width: 112px; height: 112px; }
        .avatar-initials { font-size: 38px; }
        .name { font-size: 56px; }
        .bio { font-size: 16px; }
        .grid {
          grid-template-columns: repeat(3, 1fr);
          gap: 28px;
          padding: 36px var(--bleed) 72px;
        }
        .cta { padding: 64px var(--bleed); }
        .cta-head { font-size: 32px; }
      }
    </style>
  </head>
  <body>

    <!-- wordmark -->
    <header class="top">
      <span>kalamansi</span>
    </header>

    <!-- header -->
    <section class="hdr">
      <div class="hdr-row">
        <div class="avatar">
          {profile.avatar_url ? (
            <img src={profile.avatar_url} alt={profile.display_name} />
          ) : (
            <span class="avatar-initials">{initials}</span>
          )}
        </div>
        <div class="hdr-text">
          <h1 class="name">{profile.display_name}&rsquo;s kitchen</h1>
          <p class="bio">Mom of two, Albany CA. Relentlessly ambitious in the kitchen, terrible at mise en place. Everything I share here is something we actually eat.</p>
          <div class="stats">
            <div>
              <div class="stat-num">{recipeCount}</div>
              <div class="stat-lbl">keepers</div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- recipe grid -->
    <main class="grid">
      {recipes && recipes.map((recipe, i) => (
        <a class="card" href={`/recipe/${recipe.id}`}>
          <div class="card-photo" style={`background: ${WARM_TONES[i % 6]};`}>
            <span class="card-emoji">{getRecipeEmoji(recipe)}</span>
            {(recipe.auto_tags?.format || recipe.auto_tags?.dish_type) && (
              <span class="card-format-label">{(recipe.auto_tags?.format ?? recipe.auto_tags?.dish_type).replace(/_/g, ' ')}</span>
            )}
          </div>
          <div class="card-body">
            {recipe.is_original ? (
              <span class="badge">Original</span>
            ) : recipe.attribution ? (
              <div class="src">Adapted from <strong>{recipe.attribution}</strong></div>
            ) : recipe.cookbook_name ? (
              <div class="src">From <strong>{recipe.cookbook_name}</strong></div>
            ) : null}
            <h3 class="dish">{recipe.name}</h3>
            {recipe.my_adaptations && (
              <p class="note">{truncate(recipe.my_adaptations, 100)}</p>
            )}
          </div>
        </a>
      ))}
    </main>

    <!-- CTA -->
    <section class="cta">
      <div class="cta-inner">
        <h2 class="cta-head">Build your own kitchen.<br />Get Kalamansi</h2>
        <p class="cta-sub">Kalamansi is a private notebook for the things you actually cook. Log meals, keep recipes, spot patterns.</p>
        <a class="cta-btn" href="/">App Store <span style="font-size:14px;">&rarr;</span></a>
      </div>
    </section>

    <!-- footer -->
    <footer class="ftr">
      <span>getkalamansi.com</span>
      <a href="/privacy">Privacy</a>
    </footer>

  </body>
</html>
