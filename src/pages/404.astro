---
const pageTitle = "Page not found · Kalamansi";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>{pageTitle}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/cute-kalamansi.png" />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Crimson+Text:ital,wght@0,400;0,600;0,700;1,400;1,600&family=Inter:wght@400;500;600;700&display=swap"
    />
    <style>
      :root {
        --bg: #F0EEE9;
        --fg: #363230;
        --fg-muted: #8C8480;
        --fg-faint: #C4BFB9;
        --fg-on-primary: #FFFFFF;
        --primary: #6B7A2F;
        --font-display: "Crimson Text", "Iowan Old Style", Georgia, serif;
        --font-body: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        --max-width: 1100px;
        --bleed: 20px;
      }

      *, *::before, *::after { box-sizing: border-box; }
      html, body { margin: 0; height: 100%; }
      body {
        background: var(--bg);
        color: var(--fg);
        font-family: var(--font-body);
        -webkit-font-smoothing: antialiased;
        line-height: 1.5;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
      }
      a { color: inherit; text-decoration: none; }

      .header {
        max-width: var(--max-width);
        margin: 0 auto;
        padding: 24px var(--bleed) 0;
        width: 100%;
      }
      .logo {
        display: flex;
        align-items: center;
        gap: 6px;
        width: fit-content;
      }
      .logo img {
        width: 22px;
        height: 22px;
        border-radius: 5px;
      }
      .logo span {
        font-size: 13px;
        color: var(--fg-muted);
        letter-spacing: 0.5px;
      }

      .main {
        flex: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        padding: 40px var(--bleed);
        gap: 18px;
      }
      .main img {
        width: 88px;
        height: 88px;
        object-fit: contain;
      }
      .main h1 {
        font-family: var(--font-display);
        font-weight: 600;
        font-size: 32px;
        color: var(--fg);
        margin: 0;
      }
      .main p {
        font-size: 15px;
        color: var(--fg-muted);
        max-width: 30em;
        margin: 0;
        line-height: 1.5;
      }
      .btn-primary {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: var(--primary);
        color: var(--fg-on-primary);
        font-size: 15px;
        font-weight: 600;
        padding: 12px 24px;
        border-radius: 999px;
        margin-top: 6px;
      }

      .footer {
        max-width: var(--max-width);
        margin: 0 auto;
        padding: 0 var(--bleed) 40px;
        width: 100%;
        text-align: center;
        font-size: 12px;
        color: var(--fg-faint);
      }
    </style>
  </head>
  <body>
    <header class="header">
      <a href="/" class="logo">
        <img src="/cute-kalamansi.png" alt="" />
        <span>kalamansi</span>
      </a>
    </header>

    <section class="main">
      <img src="/cute-kalamansi.png" alt="" />
      <h1>This page wandered off the recipe.</h1>
      <p>We couldn't find what you were looking for. It may have moved, or the link might be off.</p>
      <a href="/" class="btn-primary">Back to Kalamansi</a>
    </section>

    <footer class="footer">getkalamansi.com</footer>
  </body>
</html>
