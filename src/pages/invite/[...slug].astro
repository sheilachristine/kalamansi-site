---
import Layout from '../../layouts/Layout.astro';

const { slug } = Astro.params;

// Real invite links always carry a code (getkalamansi.com/invite/{code}).
// app.getkalamansi.com/invite/:code already has a complete, working
// accept flow (invite lookup, expiry/used-state handling, signup/login,
// auto-accept) — so hand the code straight to it instead of showing
// generic copy that discards it.
if (slug) {
  return Astro.redirect(`https://app.getkalamansi.com/invite/${slug}`, 302);
}
---

<Layout title="Join Kalamansi">
  <h1>You've been invited to Kalamansi</h1>
  <p>Install the app on your iPhone to accept this invite and join your household.</p>
  <p>Ask the person who invited you for a TestFlight link to download the app.</p>
  <p class="note">Already have the app installed? Open this link again after installing and it will open automatically.</p>
</Layout>

<style>
  body {
    max-width: 480px;
  }
  h1 {
    font-size: 36px;
    margin-bottom: 8px;
  }
  p {
    color: #555;
  }
  .note {
    font-size: 14px;
    color: #888;
    margin-top: 24px;
  }
</style>
