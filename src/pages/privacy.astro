---
const pageTitle = "Privacy policy · Kalamansi";
const pageDescription = "Kalamansi is a private notebook for your household. This page explains what we collect and how you stay in control of it.";
const contactEmail = "heysheila@gmail.com";
const lastUpdated = "Last updated July 1, 2026";

const sections = [
  {
    label: "What we collect",
    body: "Account details (name, email), the meals and recipes you log, and household membership. We don't collect location, contacts, or browsing history.",
  },
  {
    label: "How we use it",
    body: "To show you your own logged meals and recipes, and to surface patterns in what your household cooks. We never sell your data, and we don't use it for advertising.",
  },
  {
    label: "Who can see it",
    body: "Meals and recipes you log are visible only to your household by default. If you share a recipe on your public kitchen page: original recipes show in full, while linked recipes show ingredients only. You control what's shared.",
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>{pageTitle}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={pageDescription} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:image" content="https://getkalamansi.com/cute-kalamansi.png" />
    <meta property="og:type" content="website" />
    <link rel="icon" href="/cute-kalamansi.png" />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Crimson+Text:ital,wght@0,400;0,600;0,700;1,400;1,600&family=Inter:wght@400;500;600;700&display=swap"
    />
    <style>
      :root {
        --bg: #F0EEE9;
        --fg: #363230;
        --fg-muted: #8C8480;
        --fg-faint: #C4BFB9;
        --border: #E8E4DE;
        --primary: #6B7A2F;
        --font-display: "Crimson Text", "Iowan Old Style", Georgia, serif;
        --font-body: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        --max-width: 760px;
        --bleed: 20px;
      }

      *, *::before, *::after { box-sizing: border-box; }
      html, body { margin: 0; }
      body {
        background: var(--bg);
        color: var(--fg);
        font-family: var(--font-body);
        -webkit-font-smoothing: antialiased;
        line-height: 1.6;
      }
      a { color: inherit; text-decoration: none; }

      .header {
        max-width: var(--max-width);
        margin: 0 auto;
        padding: 24px var(--bleed) 0;
      }
      .logo {
        display: flex;
        align-items: center;
        gap: 6px;
        width: fit-content;
      }
      .logo img {
        width: 22px;
        height: 22px;
        border-radius: 5px;
      }
      .logo span {
        font-size: 13px;
        color: var(--fg-muted);
        letter-spacing: 0.5px;
      }

      .title {
        max-width: var(--max-width);
        margin: 0 auto;
        padding: 32px var(--bleed) 8px;
      }
      .title h1 {
        font-family: var(--font-display);
        font-weight: 600;
        font-size: 40px;
        color: var(--fg);
        letter-spacing: -0.01em;
        margin: 0 0 8px;
      }
      .title p {
        font-size: 13px;
        color: var(--fg-muted);
        margin: 0;
      }

      .intro {
        max-width: var(--max-width);
        margin: 0 auto;
        padding: 32px var(--bleed) 0;
      }
      .intro p {
        font-size: 15px;
        color: var(--fg);
        margin: 0 0 8px;
      }

      .policy-section {
        max-width: var(--max-width);
        margin: 0 auto;
        padding: 32px var(--bleed);
        border-top: 1px solid var(--border);
      }
      .policy-section:last-of-type {
        padding-bottom: 64px;
      }
      .policy-eyebrow {
        font-size: 11px;
        font-weight: 600;
        color: var(--fg-muted);
        letter-spacing: 1.5px;
        text-transform: uppercase;
        margin: 0 0 14px;
      }
      .policy-body {
        font-size: 15px;
        color: var(--fg);
        margin: 0;
      }
      .policy-body a {
        color: var(--primary);
      }

      .footer {
        max-width: var(--max-width);
        margin: 0 auto;
        padding: 28px var(--bleed) 48px;
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        font-size: 12px;
        color: var(--fg-faint);
        border-top: 1px solid var(--border);
      }
      .footer-links {
        display: flex;
        gap: 20px;
      }
      .footer-links a { color: var(--fg-muted); }
    </style>
  </head>
  <body>
    <header class="header">
      <a href="/" class="logo">
        <img src="/cute-kalamansi.png" alt="" />
        <span>kalamansi</span>
      </a>
    </header>

    <section class="title">
      <h1>Privacy policy</h1>
      <p>{lastUpdated}</p>
    </section>

    <section class="intro">
      <p>{pageDescription}</p>
    </section>

    {sections.map((s) => (
      <section class="policy-section">
        <p class="policy-eyebrow">{s.label}</p>
        <p class="policy-body">{s.body}</p>
      </section>
    ))}

    <section class="policy-section">
      <p class="policy-eyebrow">Questions</p>
      <p class="policy-body"><a href={`mailto:${contactEmail}`}>{contactEmail}</a></p>
    </section>

    <footer class="footer">
      <span>getkalamansi.com</span>
      <div class="footer-links">
        <a href="/">Home</a>
        <a href="/support">Support</a>
      </div>
    </footer>
  </body>
</html>
