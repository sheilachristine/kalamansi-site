---
import { supabase } from "../../lib/supabase";

const { handle } = Astro.params;

const { data: profile } = await supabase
  .from('user_profiles')
  .select('user_id, household_id, display_name, handle, avatar_url')
  .eq('handle', handle)
  .single();

if (!profile) {
  return new Response(null, { status: 404, statusText: "Not found" });
}

const { data: recipes } = await supabase
  .from('recipes')
  .select('id, name, source, link, attribution, cookbook_name, is_original, recipe_status, auto_tags, kitchen_section')
  .eq('household_id', profile.household_id)
  .eq('recipe_status', 'keeper')
  .or('is_hidden.eq.false,is_hidden.is.null')
  .order('name', { ascending: true });

const recipeCount = recipes?.length ?? 0;
const initials = profile.display_name
  .split(' ')
  .map((w: string) => w[0])
  .join('')
  .toUpperCase()
  .slice(0, 2);
const pageTitle = `${profile.display_name}'s kitchen · Kalamansi`;

const SMALL_WORDS = new Set([
  'a','an','the','and','but','or','for','nor',
  'on','at','to','by','in','of','with','from',
]);

function toTitleCase(text: string): string {
  const words = text.split(/\s+/);
  return words.map((word, i) => {
    const lower = word.toLowerCase();
    if (i === 0 || i === words.length - 1 || !SMALL_WORDS.has(lower)) {
      return word.charAt(0).toUpperCase() + word.slice(1).toLowerCase();
    }
    return lower;
  }).join(' ');
}

const SECTION_ORDER = [
  { key: 'baked_goods_desserts', label: 'Baked goods & desserts' },
  { key: 'breakfast',            label: 'Breakfast' },
  { key: 'pasta',                label: 'Pasta' },
  { key: 'soups',                label: 'Soups' },
  { key: 'vegetables_sides',    label: 'Vegetables & sides' },
  { key: 'protein',              label: 'Protein' },
] as const;

type SectionKey = typeof SECTION_ORDER[number]['key'];

function getKitchenSection(recipe: any): SectionKey {
  if (recipe.kitchen_section && SECTION_ORDER.some(s => s.key === recipe.kitchen_section)) {
    return recipe.kitchen_section as SectionKey;
  }
  const tags = typeof recipe.auto_tags === 'string' ? JSON.parse(recipe.auto_tags) : (recipe.auto_tags ?? {});
  const format = tags.format;
  const protein = tags.protein;
  if (format === 'baked_good') return 'baked_goods_desserts';
  if (format === 'pasta') return 'pasta';
  if (format === 'soup') return 'soups';
  if (format === 'breakfast' || protein === 'eggs') return 'breakfast';
  if (format === 'salad') return 'vegetables_sides';
  if (protein && protein !== 'none' && protein !== 'eggs') return 'protein';
  return 'vegetables_sides';
}

const grouped = new Map<SectionKey, typeof recipes>(
  SECTION_ORDER.map(s => [s.key, []])
);
for (const r of (recipes ?? [])) {
  grouped.get(getKitchenSection(r))!.push(r);
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>{pageTitle}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={`${profile.display_name}'s kitchen on Kalamansi — ${recipeCount} keeper recipes`} />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Crimson+Text:ital,wght@0,400;0,600;0,700;1,400;1,600&family=Inter:wght@400;500;600;700&display=swap"
    />
    <style>
      :root {
        /* Surfaces */
        --bg: #F0EEE9;
        --surface: #FFFFFF;
        --border: #E8E4DE;
        /* Text */
        --fg: #363230;
        --fg-muted: #8C8480;
        --fg-faint: #C4BFB9;
        /* Brand */
        --teal: #1D9E75;
        --teal-light: #E6F4EF;
        /* Warm tones */
        --warm-card: #E8E3D8;
        --warm-fg: #3A3028;
        --warm-fg-muted: #6A5840;
        /* Type */
        --font-display: "Crimson Text", "Iowan Old Style", Georgia, serif;
        --font-body: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        /* Layout */
        --bleed: 20px;
        --max-width: 1100px;
      }

      *, *::before, *::after { box-sizing: border-box; }
      html, body { margin: 0; }
      body {
        background: var(--bg);
        color: var(--fg);
        font-family: var(--font-body);
        -webkit-font-smoothing: antialiased;
        line-height: 1.5;
      }
      a { color: inherit; text-decoration: none; }

      /* ─── top wordmark ─────────────────────────── */
      .top {
        max-width: var(--max-width);
        margin: 0 auto;
        padding: 20px var(--bleed) 0;
        display: flex;
        justify-content: flex-end;
        align-items: center;
        gap: 6px;
      }
      .top span {
        font-size: 13px;
        color: var(--fg-muted);
        letter-spacing: 0.5px;
      }

      /* ─── header ───────────────────────────────── */
      .hdr {
        max-width: var(--max-width);
        margin: 0 auto;
        padding: 32px var(--bleed) 24px;
      }
      .hdr-row {
        display: flex;
        flex-direction: row;
        align-items: flex-start;
        gap: 24px;
      }
      .avatar {
        width: 80px;
        height: 80px;
        border-radius: 50%;
        background: var(--surface);
        border: 1px solid var(--border);
        overflow: hidden;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
      }
      .avatar img {
        width: 100%;
        height: 100%;
        object-fit: cover;
      }
      .avatar-initials {
        font-family: var(--font-display);
        font-weight: 600;
        font-size: 28px;
        color: var(--fg-muted);
        line-height: 1;
      }
      .hdr-text {
        flex: 1;
        min-width: 0;
      }
      .name {
        font-family: var(--font-display);
        font-weight: 600;
        font-size: 36px;
        color: var(--fg);
        line-height: 1.05;
        letter-spacing: -0.01em;
        margin: 0;
      }
      .bio {
        font-size: 15px;
        color: var(--fg-muted);
        margin: 6px 0 0;
        max-width: 38em;
        line-height: 1.5;
      }
      .stats {
        display: flex;
        gap: 28px;
        margin-top: 14px;
      }
      .stat-num {
        font-family: var(--font-display);
        font-weight: 600;
        font-size: 24px;
        color: var(--fg);
        line-height: 1;
      }
      .stat-lbl {
        font-size: 12px;
        color: var(--fg-muted);
        margin-top: 4px;
        letter-spacing: 0.15px;
      }

      /* ─── sections ────────────────────────────── */
      .k-section {
        max-width: var(--max-width);
        margin: 0 auto;
      }
      .section-label {
        padding: 0 var(--bleed);
        margin-top: 16px;
        margin-bottom: 8px;
        font-family: var(--font-body);
        font-weight: 600;
        font-size: 14px;
        color: var(--fg);
        line-height: 1.2;
      }
      .section-toggle {
        display: none;
      }

      /* ─── mobile collapsible ────────────────── */
      @media (max-width: 759px) {
        .section-toggle {
          display: flex;
          align-items: center;
          justify-content: space-between;
          padding: 14px var(--bleed);
          cursor: pointer;
          -webkit-tap-highlight-color: transparent;
        }
        .section-toggle-label {
          font-family: var(--font-body);
          font-weight: 600;
          font-size: 11px;
          text-transform: uppercase;
          letter-spacing: 0.8px;
          color: var(--fg);
        }
        .section-toggle-count {
          font-size: 11px;
          color: var(--fg-muted);
          font-weight: 400;
          margin-left: 6px;
        }
        .section-toggle-chevron {
          font-size: 18px;
          color: var(--fg-muted);
          line-height: 1;
          transition: transform 200ms ease;
          transform: rotate(0deg);
        }
        .section-toggle-chevron.open {
          transform: rotate(180deg);
        }
        .section-label {
          display: none;
        }
        .name {
          font-size: 26px;
        }
        .hdr {
          padding-bottom: 12px;
        }
        .bio {
          font-size: 12px;
        }
        .section-toggle {
          padding-top: 0;
        }
        .grid.k-cards {
          display: none;
        }
        .grid.k-cards.open {
          display: grid;
        }
      }

      /* ─── grid ─────────────────────────────────── */
      .grid {
        max-width: var(--max-width);
        margin: 0 auto;
        padding: 16px var(--bleed) 8px;
        display: grid;
        grid-template-columns: 1fr;
        gap: 12px;
      }
      .card {
        background: #FAF8F4;
        border: 1px solid var(--border);
        border-radius: 14px;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        cursor: pointer;
        transition: transform 180ms ease, border-color 180ms ease;
      }
      .card:hover {
        border-color: #D7D0C5;
        transform: translateY(-1px);
      }
      .card-body {
        padding: 12px 14px;
        display: flex;
        flex-direction: column;
        gap: 6px;
      }
      .src {
        font-size: 12px;
        color: var(--fg-muted);
        letter-spacing: 0.1px;
      }
      .src strong {
        color: var(--fg);
        font-weight: 500;
        white-space: nowrap;
      }
      .badge {
        display: inline-block;
        padding: 2px 8px;
        border-radius: 999px;
        background: var(--teal-light);
        color: var(--teal);
        font-size: 11px;
        font-weight: 600;
        letter-spacing: 0.6px;
        text-transform: uppercase;
        align-self: flex-start;
      }
      .dish {
        font-family: var(--font-display);
        font-weight: 600;
        font-size: 22px;
        color: var(--fg);
        line-height: 1.18;
        margin: 0;
      }
      /* ─── CTA ──────────────────────────────────── */
      .cta {
        background: var(--warm-card);
        padding: 40px var(--bleed);
        margin-top: 32px;
      }
      .cta-inner {
        max-width: var(--max-width);
        margin: 0 auto;
        text-align: center;
      }
      .cta-head {
        font-family: var(--font-display);
        font-weight: 600;
        font-size: 26px;
        color: var(--warm-fg);
        margin: 0 0 8px;
        line-height: 1.15;
      }
      .cta-sub {
        font-size: 14px;
        color: var(--warm-fg-muted);
        margin: 0 0 18px;
        max-width: 28em;
        margin-left: auto;
        margin-right: auto;
        line-height: 1.5;
      }
      .cta-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: var(--warm-fg);
        color: var(--bg);
        font-family: var(--font-body);
        font-size: 15px;
        font-weight: 600;
        padding: 12px 22px;
        border-radius: 999px;
        cursor: pointer;
        border: none;
        letter-spacing: 0.1px;
      }
      .cta-btn:hover { background: #2A211B; }

      /* ─── footer ──────────────────────────────── */
      .ftr {
        padding: 28px var(--bleed) 48px;
        max-width: var(--max-width);
        margin: 0 auto;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        font-size: 12px;
        color: var(--fg-faint);
      }
      .ftr a { color: var(--fg-muted); }

      /* ─── DESKTOP ─────────────────────────────── */
      @media (min-width: 760px) {
        :root { --bleed: 32px; }
        .top { padding-top: 28px; }
        .hdr { padding: 56px var(--bleed) 36px; }
        .hdr-row { gap: 40px; }
        .avatar { width: 112px; height: 112px; }
        .avatar-initials { font-size: 38px; }
        .name { font-size: 56px; }
        .bio { font-size: 16px; }
        .grid {
          grid-template-columns: repeat(3, 1fr);
          gap: 12px;
          padding: 36px var(--bleed) 72px;
        }
        .k-cards {
          display: grid !important;
        }
        .cta { padding: 64px var(--bleed); }
        .cta-head { font-size: 32px; }
      }
    </style>
  </head>
  <body>

    <!-- wordmark -->
    <header class="top">
      <span>kalamansi</span>
    </header>

    <!-- header -->
    <section class="hdr">
      <div class="hdr-row">
        <div class="avatar">
          {profile.avatar_url ? (
            <img src={profile.avatar_url} alt={profile.display_name} />
          ) : (
            <span class="avatar-initials">{initials}</span>
          )}
        </div>
        <div class="hdr-text">
          <h1 class="name">{profile.display_name}&rsquo;s kitchen</h1>
          <p class="bio">Mom of two, Albany CA. Relentlessly ambitious in the kitchen, terrible at mise en place. Everything I share here is something we actually eat.</p>
          <div class="stats">
            <div>
              <div class="stat-num">{recipeCount}</div>
              <div class="stat-lbl">keepers</div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- recipe grid -->
    <main>
      {SECTION_ORDER.map(s => {
        const items = grouped.get(s.key)!;
        if (items.length === 0) return null;
        return (
          <div class="k-section" data-section={s.key}>
            <div class="section-toggle">
              <span>
                <span class="section-toggle-label">{s.label}</span>
                <span class="section-toggle-count">{items.length}</span>
              </span>
              <span class="section-toggle-chevron" set:html="&#8964;" />
            </div>
            <h2 class="section-label">{s.label}</h2>
            <div class="grid k-cards">
              {items.map((recipe) => (
                <a class="card" href={`/recipe/${recipe.id}`}>
                  <div class="card-body">
                    {recipe.is_original ? (
                      <span class="badge">Original</span>
                    ) : recipe.attribution ? (
                      <div class="src">Adapted from <strong>{recipe.attribution}</strong></div>
                    ) : recipe.cookbook_name ? (
                      <div class="src">From <strong>{recipe.cookbook_name}</strong></div>
                    ) : null}
                    <h3 class="dish">{toTitleCase(recipe.name)}</h3>
                  </div>
                </a>
              ))}
            </div>
          </div>
        );
      })}
    </main>

    <!-- CTA -->
    <section class="cta">
      <div class="cta-inner">
        <h2 class="cta-head">Build your own kitchen.<br />Get Kalamansi</h2>
        <p class="cta-sub">Kalamansi is a private notebook for the things you actually cook. Log meals, keep recipes, spot patterns.</p>
        <a class="cta-btn" href="/">App Store <span style="font-size:14px;">&rarr;</span></a>
      </div>
    </section>

    <!-- footer -->
    <footer class="ftr">
      <span>getkalamansi.com</span>
      <a href="/privacy">Privacy</a>
    </footer>

    <script>
      document.querySelectorAll('.section-toggle').forEach(toggle => {
        toggle.addEventListener('click', () => {
          const section = toggle.closest('.k-section');
          const chevron = toggle.querySelector('.section-toggle-chevron');
          const cards = section.querySelector('.k-cards');
          chevron.classList.toggle('open');
          cards.classList.toggle('open');
        });
      });
    </script>
  </body>
</html>
