---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <style is:global>
      body {
        font-family: system-ui, sans-serif;
        margin: 80px auto;
        padding: 0 24px;
        line-height: 1.6;
      }
    </style>
  </head>
  <body>
    <slot />
  </body>
</html>
