---
// Fallback for password reset links pointing to getkalamansi.com.
// On iOS/Android with the native app installed, the AASA / intent filter
// intercepts this URL before the browser loads — so this page never runs.
// For everyone else (desktop, mobile without app), redirect to the Expo
// web app at app.getkalamansi.com which has the full reset-password flow.
---

<!doctype html>
<html>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Kalamansi — Reset Password</title>
  </head>
  <body>
    <script is:inline>
      window.location.replace(
        "https://app.getkalamansi.com/reset-password"
          + window.location.search
          + window.location.hash
      );
    </script>
    <noscript>
      <p>Redirecting to <a href="https://app.getkalamansi.com/reset-password">app.getkalamansi.com</a>...</p>
    </noscript>
  </body>
</html>
